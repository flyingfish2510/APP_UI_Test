// APP_UI_Test 定时回归流水线（Jenkins 控制器在 Docker，测试跑在 Windows 宿主机 agent）
// 定时触发由 jenkins/init/create-job.groovy 在 Jenkins 启动时注入（TimerTrigger）。
pipeline {
    agent {
        node {
            label 'windows-host'
            customWorkspace 'D:\\DeepSeekTest\\APP_UI_Test'
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '30'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(name: 'TEST_MARKER', choices: ['smoke', 'regression', 'p0', 'p1', 'p2', 'p3', 'all'],
               description: '按 pytest 标记筛选用例')
        string(name: 'RERUNS', defaultValue: '0', description: '失败重跑次数')
        string(name: 'PYTEST_TIMEOUT', defaultValue: '300', description: '单用例超时（秒）')
        booleanParam(name: 'CLEAN_ARTIFACTS', defaultValue: true, description: '开始前清理旧报告/截图')
    }

    environment {
        TZ               = 'Asia/Shanghai'
        RUN_ENV          = 'local'
        PYTHON           = 'D:\\DeepSeekTest\\APP_UI_Test\\.venv\\Scripts\\python.exe'
        PYTHONIOENCODING = 'utf-8'
    }

    stages {
        stage('准备') {
            steps {
                script {
                    def clean = (params.CLEAN_ARTIFACTS == null) ? true : params.CLEAN_ARTIFACTS
                    withEnv(["CLEAN_ARTIFACTS_ARG=${clean}"]) {
                        powershell '''
                            if (-not (Test-Path pytest.ini)) { Write-Error '缺少 pytest.ini'; exit 1 }
                            if (-not (Test-Path 'config/config.yaml')) { Write-Error '缺少 config/config.yaml'; exit 1 }
                            New-Item -ItemType Directory -Force -Path reports, logs, screenshots | Out-Null
                            if ($env:CLEAN_ARTIFACTS_ARG -eq 'true') {
                                Remove-Item -Recurse -Force reports/allure-results, reports/allure-report, reports/junit.xml -ErrorAction SilentlyContinue
                                Get-ChildItem screenshots -Filter *.png -File -ErrorAction SilentlyContinue |
                                    Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-7) } |
                                    Remove-Item -Force -ErrorAction SilentlyContinue
                            }
                        '''
                    }
                    def ver = powershell(script: '& $env:PYTHON --version', returnStdout: true).trim()
                    echo "Python: ${ver}"
                }
            }
        }

        stage('环境检查') {
            steps {
                powershell '''
                    & adb version | Select-Object -First 1
                    $devices = & adb devices
                    $devices
                    if (-not ($devices -match "\tdevice")) {
                        Write-Error '没有可用设备（adb devices 为空或未授权）'
                        exit 1
                    }
                    & $env:PYTHON -c "import sys, pytest, selenium; print(sys.version.split()[0], '| selenium', selenium.__version__, '| pytest', pytest.__version__)"
                '''
            }
        }

        stage('执行测试') {
            steps {
                script {
                    def marker = (params.TEST_MARKER ?: 'all').toString().trim()
                    def reruns = (params.RERUNS ?: '0').toString().trim()
                    def tmo    = (params.PYTEST_TIMEOUT ?: '300').toString().trim()
                    withEnv(["MARKER_ARG=${marker}", "RERUNS_ARG=${reruns}", "TMO_ARG=${tmo}"]) {
                        powershell '''
                            $pytestArgs = @('-m', 'pytest', 'testcases/')
                            if ($env:MARKER_ARG -ne 'all') { $pytestArgs += @('-m', $env:MARKER_ARG) }
                            $pytestArgs += @(
                                '--alluredir=reports/allure-results',
                                '--clean-alluredir',
                                '--junitxml=reports/junit.xml',
                                "--timeout=$($env:TMO_ARG)",
                                '--reruns', $env:RERUNS_ARG, '--reruns-delay', '3',
                                '--maxfail=0',
                                '-p', 'no:cacheprovider',
                                '--tb=short', '--disable-warnings', '-q'
                            )
                            Write-Host ($env:PYTHON + ' ' + ($pytestArgs -join ' '))
                            & $env:PYTHON @pytestArgs
                            exit $LASTEXITCODE
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'reports/junit.xml'
            catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                allure includeProperties: false, jdk: '', results: [[path: 'reports/allure-results']]
            }
            archiveArtifacts artifacts: 'logs/*.log, reports/junit.xml', allowEmptyArchive: true
        }
        failure {
            script {
                if (env.MAIL_TO?.trim()) {
                    try {
                        emailext(
                            to: env.MAIL_TO,
                            subject: "[失败] ${env.JOB_NAME} #${env.BUILD_NUMBER} (${params.TEST_MARKER})",
                            body: "构建: <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a><br/>Allure: <a href='${env.BUILD_URL}allure/'>${env.BUILD_URL}allure/</a>",
                            mimeType: 'text/html',
                            attachLog: true
                        )
                    } catch (e) {
                        echo "邮件发送失败（请检查系统管理 → 系统配置 → 邮件）：${e}"
                    }
                }
            }
        }
    }
}
